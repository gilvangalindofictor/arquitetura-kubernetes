    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7},
      "id": 101,
      "title": "Quality Gate Pass/Fail Ratio",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Pass Rate"},
            "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "Fail Rate"},
            "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 10,
      "options": {
        "legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "sum(rate(gitlab_ci_pipeline_security_scan_status{project=~\"$project\"}[1h])) / count(gitlab_ci_pipeline_security_scan_status{project=~\"$project\"})",
          "legendFormat": "Pass Rate",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "1 - (sum(rate(gitlab_ci_pipeline_security_scan_status{project=~\"$project\"}[1h])) / count(gitlab_ci_pipeline_security_scan_status{project=~\"$project\"}))",
          "legendFormat": "Fail Rate",
          "refId": "B"
        }
      ],
      "title": "Overall Security Scan Pass/Fail Rate (1h rolling)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
