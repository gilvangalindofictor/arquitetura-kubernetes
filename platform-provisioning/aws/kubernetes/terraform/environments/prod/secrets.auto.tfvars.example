# =============================================================================
# secrets.auto.tfvars.example — PROD
# =============================================================================
#
# ATENÇÃO: Este é apenas um TEMPLATE de documentação.
# NÃO colocar valores reais aqui. Este arquivo É versionado no git.
#
# GAP-TF-006: secrets.auto.tfvars foi descontinuado.
# Use o script: source scripts/export-tf-vars.sh prod
# O script carrega os secrets do AWS Secrets Manager como TF_VAR_*.
#
# Para migration gradual (uso local temporário):
#   1. Copie este arquivo: cp secrets.auto.tfvars.example secrets.auto.tfvars
#   2. Preencha os valores reais (o arquivo é git-ignorado)
#   3. Planeje migrar para o script acima o quanto antes
#
# Variáveis obrigatórias (sem default) — devem ser fornecidas:
# =============================================================================

# --- Vault ---
# Obtido via: vault operator generate-root (recovery keys)
# Necessário apenas para módulo vault_config_prod (rotação de políticas/secrets)
# Token expira entre sessões — gerar fresh a cada uso.
vault_root_token = "CHANGE_ME"

# --- Vault OIDC Client ---
# Obtido via Keycloak: Clients > vault > Credentials > Client secret
vault_oidc_client_secret = "CHANGE_ME"

# --- Grafana ---
grafana_oidc_client_secret = "CHANGE_ME"
grafana_admin_password     = "CHANGE_ME"

# --- SonarQube ---
sonarqube_postgresql_password = "CHANGE_ME"

# --- Harbor ---
harbor_postgresql_password = "CHANGE_ME"
harbor_admin_password      = "CHANGE_ME"
harbor_redis_password      = "CHANGE_ME"

# --- ArgoCD ---
argocd_postgresql_password = "CHANGE_ME"
argocd_oidc_client_secret  = "CHANGE_ME"

# --- Keycloak ---
keycloak_postgresql_password = "CHANGE_ME"
keycloak_admin_password      = "CHANGE_ME"
