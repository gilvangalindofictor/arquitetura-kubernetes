          ]
        ]
      }
    },
    {
      "id": 6,
      "title": "Cost per Node Group",
      "description": "Estimated compute cost allocation per node group",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (label_eks_amazonaws_com_nodegroup) (kube_node_labels) * 24 * 30 * 0.0416",
          "legendFormat": "{{label_eks_amazonaws_com_nodegroup}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    }
  ]
}
