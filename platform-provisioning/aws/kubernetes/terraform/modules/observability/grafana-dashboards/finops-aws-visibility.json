        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "legend": false, "tooltip": false, "viz": false }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Tabela: App / Custo / % Total",
      "type": "table",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(app) (aws_cost_by_tag_usd{environment=\"$environment\"})",
          "instant": true,
          "legendFormat": "{{app}}",
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by(app) (aws_cost_by_tag_usd{environment=\"$environment\"}) / sum(aws_cost_by_tag_usd{environment=\"$environment\"}) * 100",
          "instant": true,
          "legendFormat": "{{app}}",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Value #A", "desc": true }],
        "footer": { "show": false, "reducer": ["sum"] }
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "app": "App",
              "Value #A": "Custo MTD (USD)",
              "Value #B": "% do Total"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Custo MTD (USD)" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": {
