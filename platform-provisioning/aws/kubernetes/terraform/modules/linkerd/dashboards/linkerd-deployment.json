      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(irate(response_total{classification=\"success\", namespace=\"$namespace\", deployment=\"$deployment\", direction=\"inbound\"}[5m])) / sum(irate(response_total{namespace=\"$namespace\", deployment=\"$deployment\", direction=\"inbound\"}[5m]))",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
