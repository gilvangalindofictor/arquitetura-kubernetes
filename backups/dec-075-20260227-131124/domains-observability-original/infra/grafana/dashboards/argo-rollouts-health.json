{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource from kube-prometheus-stack",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Argo Rollouts — Health Overview: Success rate per app, rollback frequency, MTTR. CICD-005.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": ["argo-rollouts"],
      "title": "Deployment Progress Dashboard",
      "tooltip": "Open deployment progress details",
      "type": "dashboards",
      "url": "/d/argo-rollouts-deployment-progress"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Platform Health Summary",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "title": "Total Active Rollouts",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "count(argo_rollout_info)",
          "instant": true,
          "legendFormat": "Rollouts",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "title": "Progressing Rollouts",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "count(argo_rollout_info{phase=\"Progressing\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Progressing",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "title": "Degraded Rollouts",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "count(argo_rollout_info{phase=\"Degraded\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Degraded",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 3}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "title": "Total Rollbacks (24h)",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "increase(argo_rollout_phase_transition_total{phase=\"Degraded\"}[24h]) or vector(0)",
          "instant": true,
          "legendFormat": "Rollbacks",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 1},
              {"color": "green", "value": 5}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "title": "Successful Promotions (24h)",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "increase(argo_rollout_phase_transition_total{phase=\"Healthy\"}[24h]) or vector(0)",
          "instant": true,
          "legendFormat": "Promotions",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "title": "Failed AnalysisRuns",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "count(argo_analysis_run_info{phase=\"Failed\"}) or vector(0)",
          "instant": true,
          "legendFormat": "Failed",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Success Rate per Application",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.90},
              {"color": "green", "value": 0.95}
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "title": "HTTP Success Rate per Service (Last 5min)",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by(service) (rate(http_requests_total{status=~\"2..\", namespace=~\"$namespace\"}[5m])) / sum by(service) (rate(http_requests_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "type": "bargauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Success Rate",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "max": 1,
          "min": 0.8,
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 8,
      "options": {
        "legend": {"calcs": ["last", "min"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "title": "Success Rate Trends — All Services",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by(service) (rate(http_requests_total{status=~\"2..\", namespace=~\"$namespace\"}[5m])) / sum by(service) (rate(http_requests_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "0.95",
          "legendFormat": "SLO (95%)",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "title": "Rollback Frequency & MTTR",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Rollbacks per hour",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 9,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "title": "Rollback Frequency (per rollout)",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "increase(argo_rollout_phase_transition_total{phase=\"Degraded\", namespace=~\"$namespace\"}[1h])",
          "legendFormat": "{{name}} ({{namespace}})",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Duration (minutes)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "m"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 10,
      "options": {
        "legend": {"calcs": ["last", "mean"], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "title": "Rollout Duration — Time in Progressing State",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "(time() - argo_rollout_created_time{namespace=~\"$namespace\"}) * argo_rollout_info{phase=\"Progressing\"} / 60",
          "legendFormat": "{{name}} — progressing duration",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "30",
          "legendFormat": "Alert threshold (30m)",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 103,
      "title": "AnalysisRun Status",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "phase"},
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {"options": {"Successful": {"color": "green", "index": 0}}, "type": "value"},
                  {"options": {"Running": {"color": "orange", "index": 1}}, "type": "value"},
                  {"options": {"Failed": {"color": "red", "index": 2}}, "type": "value"},
                  {"options": {"Error": {"color": "red", "index": 3}}, "type": "value"},
                  {"options": {"Inconclusive": {"color": "yellow", "index": 4}}, "type": "value"}
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "id": 11,
      "options": {
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Time"}]
      },
      "title": "AnalysisRun Status Table",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "argo_analysis_run_info{namespace=~\"$namespace\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"__name__": true, "job": true, "instance": true},
            "renameByName": {
              "namespace": "Namespace",
              "name": "AnalysisRun",
              "phase": "Phase"
            }
          }
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["argo-rollouts", "health", "sre", "progressive-delivery", "CICD-005"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(argo_rollout_info, namespace)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(argo_rollout_info, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Namespace"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Argo Rollouts — Health Overview",
  "uid": "argo-rollouts-health",
  "version": 1
}
