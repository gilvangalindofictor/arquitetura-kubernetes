{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource from kube-prometheus-stack",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": "${DS_PROMETHEUS}",
        "enable": true,
        "expr": "changes(argo_rollout_info{phase=\"Progressing\"}[2m]) > 0",
        "hide": false,
        "iconColor": "rgba(255, 152, 0, 1)",
        "name": "Rollout Started",
        "step": "60s",
        "titleFormat": "Rollout: {{name}}"
      },
      {
        "datasource": "${DS_PROMETHEUS}",
        "enable": true,
        "expr": "changes(argo_rollout_info{phase=\"Healthy\"}[2m]) > 0",
        "hide": false,
        "iconColor": "rgba(50, 172, 45, 1)",
        "name": "Rollout Completed",
        "step": "60s",
        "titleFormat": "Promoted: {{name}}"
      }
    ]
  },
  "description": "Argo Rollouts — Deployment Progress: Canary weight %, analysis status, rollout phase. CICD-005.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Rollout Overview",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {"options": {"Healthy": {"color": "green", "index": 0, "text": "Healthy"}}, "type": "value"},
            {"options": {"Progressing": {"color": "orange", "index": 1, "text": "Progressing"}}, "type": "value"},
            {"options": {"Degraded": {"color": "red", "index": 2, "text": "Degraded"}}, "type": "value"},
            {"options": {"Paused": {"color": "blue", "index": 3, "text": "Paused"}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "phase",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Rollout Phase",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "argo_rollout_info{namespace=~\"$namespace\", name=~\"$rollout\"}",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null},
              {"color": "orange", "value": 20},
              {"color": "green", "value": 100}
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "title": "Canary Weight %",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "argo_rollout_info{namespace=~\"$namespace\", name=~\"$rollout\"} * on(name, namespace) group_left() argo_rollout_weight{namespace=~\"$namespace\", name=~\"$rollout\"}",
          "instant": true,
          "legendFormat": "{{name}} canary weight",
          "refId": "A"
        }
      ],
      "type": "gauge"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"Successful": {"color": "green", "index": 0}}, "type": "value"},
            {"options": {"Running": {"color": "orange", "index": 1}}, "type": "value"},
            {"options": {"Failed": {"color": "red", "index": 2}}, "type": "value"},
            {"options": {"Error": {"color": "red", "index": 3}}, "type": "value"},
            {"options": {"Inconclusive": {"color": "yellow", "index": 4}}, "type": "value"}
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          }
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "phase",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Latest AnalysisRun Phase",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "argo_analysis_run_info{namespace=~\"$namespace\"}",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 1},
              {"color": "red", "value": 3}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "title": "Rollbacks (1h)",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "increase(argo_rollout_phase_transition_total{phase=\"Degraded\", namespace=~\"$namespace\"}[1h])",
          "instant": true,
          "legendFormat": "Rollbacks",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Canary Traffic & Analysis",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Weight %",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {"type": "linear"},
            "showPoints": "auto",
            "spanNulls": false
          },
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "options": {
        "legend": {"calcs": ["last"], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "title": "Canary Weight Over Time",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "argo_rollout_weight{namespace=~\"$namespace\", name=~\"$rollout\"}",
          "legendFormat": "{{name}} — canary %",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Success Rate",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.90},
              {"color": "green", "value": 0.95}
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "options": {
        "legend": {"calcs": ["last", "min"], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "title": "HTTP Success Rate (Canary Service)",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(http_requests_total{status=~\"2..\", service=~\"$rollout.*canary\"}[2m])) / sum(rate(http_requests_total{service=~\"$rollout.*canary\"}[2m]))",
          "legendFormat": "{{service}} — success rate",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "0.95",
          "legendFormat": "Threshold (95%)",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "title": "Latency Analysis",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Latency (ms)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "ms"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 7,
      "options": {
        "legend": {"calcs": ["last", "max"], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "title": "P95 Latency — Canary vs Stable",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"$rollout.*canary\"}[2m])) by (le)) * 1000",
          "legendFormat": "p95 canary",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=~\"$rollout.*stable\"}[2m])) by (le)) * 1000",
          "legendFormat": "p95 stable",
          "refId": "B"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "500",
          "legendFormat": "Threshold (500ms)",
          "refId": "C"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Error Rate",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "max": 0.1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 8,
      "options": {
        "legend": {"calcs": ["last", "max"], "displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single", "sort": "none"}
      },
      "title": "5xx Error Rate — Canary vs Stable",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(http_requests_total{status=~\"5..\", service=~\"$rollout.*canary\"}[2m])) / sum(rate(http_requests_total{service=~\"$rollout.*canary\"}[2m]))",
          "legendFormat": "5xx canary",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(http_requests_total{status=~\"5..\", service=~\"$rollout.*stable\"}[2m])) / sum(rate(http_requests_total{service=~\"$rollout.*stable\"}[2m]))",
          "legendFormat": "5xx stable",
          "refId": "B"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "0.01",
          "legendFormat": "Threshold (1%)",
          "refId": "C"
        }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 103,
      "title": "Rollout History",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "color-text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "phase"},
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "mappings",
                "value": [
                  {"options": {"Healthy": {"color": "green", "index": 0}}, "type": "value"},
                  {"options": {"Progressing": {"color": "orange", "index": 1}}, "type": "value"},
                  {"options": {"Degraded": {"color": "red", "index": 2}}, "type": "value"},
                  {"options": {"Paused": {"color": "blue", "index": 3}}, "type": "value"}
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "id": 9,
      "options": {
        "showHeader": true,
        "sortBy": [{"desc": true, "displayName": "Time"}]
      },
      "title": "Rollout State Table (All Namespaces)",
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "argo_rollout_info{namespace=~\"$namespace\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "type": "table",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"__name__": true, "job": true, "instance": true},
            "renameByName": {
              "namespace": "Namespace",
              "name": "Rollout",
              "phase": "Phase",
              "strategy": "Strategy"
            }
          }
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["argo-rollouts", "progressive-delivery", "canary", "blue-green", "CICD-005"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(argo_rollout_info, namespace)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "namespace",
        "options": [],
        "query": {
          "query": "label_values(argo_rollout_info, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Namespace"
      },
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(argo_rollout_info{namespace=~\"$namespace\"}, name)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "rollout",
        "options": [],
        "query": {
          "query": "label_values(argo_rollout_info{namespace=~\"$namespace\"}, name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Rollout"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Argo Rollouts — Deployment Progress",
  "uid": "argo-rollouts-deployment-progress",
  "version": 1
}
