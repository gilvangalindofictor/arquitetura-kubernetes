{
  "name": "backstage",
  "version": "1.48.0",
  "private": true,
  "description": "Backstage IDP — Platform Team (k8s-platform-prod, ADR-055)",
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace app start\" \"yarn workspace backend start\"",
    "start": "yarn workspace backend start",
    "start-backend": "yarn workspace backend start",
    "build:all": "backstage-cli repo build --all",
    "build:api-reports": "backstage-cli repo build --api-reports",
    "clean": "backstage-cli repo clean",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new --scope internal",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@backstage/cli": "0.29.2",
    "@backstage/core-app-api": "1.16.4",
    "@backstage/core-components": "0.16.4",
    "@backstage/core-plugin-api": "1.10.4",
    "@backstage/integration-react": "1.2.6",
    "@backstage/theme": "0.6.8",
    "concurrently": "^9.0.0",
    "prettier": "^3.4.1",
    "typescript": "~5.7.0"
  },
  "resolutions": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0"
  },
  "packageManager": "yarn@4.4.1"
}
