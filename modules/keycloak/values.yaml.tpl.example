# Example `values.yaml.tpl` additions to persist Keycloak startup resilience
extraInitContainers:
  - name: wait-for-db
    image: busybox:1.35.0
    command:
      - sh
      - -c
      - |
        set -e
        until nc -z ${postgresql_host} ${postgresql_port}; do
          echo "waiting for postgres ${postgresql_host}:${postgresql_port}..."
          sleep 5
        done

container:
  extraArgs:
    - --health-enabled=true

startupProbe:
  httpGet:
    path: /auth/health/ready
    port: 8080
  initialDelaySeconds: 30
  periodSeconds: 5
  failureThreshold: 60

tolerations:
  - key: workload
    operator: Equal
    value: critical
    effect: NoSchedule
